FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY CinemaAbyss.Events.csproj ./
RUN dotnet restore CinemaAbyss.Events.csproj

COPY . .
RUN dotnet publish CinemaAbyss.Events.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app

COPY --from=build /app/publish .
EXPOSE 8082

ENTRYPOINT ["dotnet", "CinemaAbyss.Events.dll"]
